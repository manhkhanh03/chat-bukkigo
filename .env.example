# Copy to .env and replace the placeholder. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# false: use OpenAI's default endpoint; true: use OPENAI_CUSTOM_BASE_URL.
OPENAI_USE_CUSTOM_ENDPOINT=false
OPENAI_CUSTOM_BASE_URL=

# Optional overrides. Non-secret defaults live in config/app.yaml.
# OPENAI_MODEL=gpt-5.6-terra
# APP_CONFIG_PATH=config/app.yaml
# APP_SAFETY_SALT=replace-with-a-random-private-value
# LOG_LEVEL=INFO
# LOG_FILE=logs/chat-bukkigo.log

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nail_receptionist_knowledge

# Embedding configuration (BAAI/bge-m3 Docker service)
EMBEDDING_SERVICE_URL=http://localhost:8008/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
